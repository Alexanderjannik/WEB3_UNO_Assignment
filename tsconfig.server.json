{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["server/**/*.ts", "src/model/**/*.ts", "src/utils/random_utils.ts"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
